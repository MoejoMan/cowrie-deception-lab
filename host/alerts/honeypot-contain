#!/bin/bash
# EMERGENCY: cut the honeypot off and preserve evidence.   usage: sudo honeypot-contain
# Order matters (standard incident response): CONTAIN -> PRESERVE -> NOTIFY.
# Nothing is deleted. The stopped container is kept for analysis.
set -u
[[ $EUID -eq 0 ]] || { echo "Run with: sudo honeypot-contain"; exit 1; }
HP=/opt/honeypot
TS=$(date -u +%Y%m%dT%H%M%SZ)
OUT=/root/incident-$TS
install -d -m 700 "$OUT"
log() { echo "[$(date -u +%H:%M:%S)] $*" | tee -a "$OUT/actions.log"; }

log "=== CONTAIN ==="
# 1. Silence the 'honeypot down' health alert: this stop is deliberate.
touch "$HP/MAINTENANCE"
# 2. Capture live container state BEFORE stopping (it disappears on stop).
docker inspect honeypot-cowrie-1 > "$OUT/container-inspect.json" 2>&1
docker top honeypot-cowrie-1 > "$OUT/container-processes.txt" 2>&1
# 3. Stop (not remove) the honeypot. Its port forwarding vanishes with it.
docker stop -t 5 honeypot-cowrie-1 >/dev/null 2>&1 && log "honeypot container STOPPED (kept, not removed)" \
  || log "WARNING: could not stop honeypot container"
# 4. Belt and braces: drop anything still arriving for the honeypot.
iptables -I DOCKER-USER 1 -o br-cowrie -j DROP 2>/dev/null && log "inbound to honeypot network DROPPED"

log "=== PRESERVE ==="
ps auxfww                > "$OUT/host-processes.txt"
ss -tanup                > "$OUT/host-connections.txt" 2>&1
iptables-save            > "$OUT/firewall-rules.txt"
{ who -a; last -n 50; }  > "$OUT/logins.txt" 2>&1
lsmod                    > "$OUT/kernel-modules.txt"
journalctl --since "-6h" --no-pager > "$OUT/journal-6h.txt" 2>&1
docker ps -a             > "$OUT/docker-ps.txt"
docker logs honeypot-cowrie-1 > "$OUT/cowrie-stdout.txt" 2>&1
cp -a /var/log/audit "$OUT/audit-log"
cp -a "$HP/data/cowrie/var/log/cowrie" "$OUT/cowrie-log"
cp -a "$HP/data/cowrie/var/lib/cowrie/tty" "$OUT/cowrie-tty" 2>/dev/null
ls -la "$HP/data/cowrie/var/lib/cowrie/downloads" > "$OUT/samples-list.txt" 2>&1
log "evidence collected in $OUT"

log "=== NOTIFY ==="
/usr/local/sbin/honeypot-alert warning "Honeypot CONTAINED" \
"Someone ran honeypot-contain. The honeypot is stopped and cut off.
Evidence: $OUT (root-only; hashes in SHA256SUMS)

NEXT STEPS
1. Investigate: sudo ausearch -i --start today | less, and the files in $OUT.
2. Verify evidence later: cd $OUT && sudo sha256sum -c SHA256SUMS
3. When you're sure it's safe: sudo iptables -D DOCKER-USER -o br-cowrie -j DROP; rm ~/honeypot/MAINTENANCE; cd ~/honeypot && ./up.sh && ./verify.sh
4. If you can't explain what happened: rebuild the server and rotate your WireGuard + GitHub keys." \
  && log "alert sent"

log "=== SEAL ==="
log "hashing evidence; nothing may be written to $OUT after this line"
# Hash LAST: anything written after hashing would fail verification.
( cd "$OUT" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS )
chmod -R go-rwx "$OUT"
echo "[$(date -u +%H:%M:%S)] sealed: $(wc -l < "$OUT/SHA256SUMS") files hashed, $(du -sh "$OUT" | cut -f1)"

cat <<EOF

Honeypot CONTAINED. Evidence in $OUT
To resume later (only once you know it's safe):
  sudo iptables -D DOCKER-USER -o br-cowrie -j DROP
  rm ~/honeypot/MAINTENANCE
  cd ~/honeypot && ./up.sh && ./verify.sh
EOF
